From afec1da7d83be022418dbbe6cf7be5d7cc2f5a35 Mon Sep 17 00:00:00 2001
From: kaktu5 <108426150+kaktu5@users.noreply.github.com>
Date: Wed, 4 Mar 2026 16:50:33 +0100
Subject: [PATCH] shorten process command paths

Strip leading path from command name and shorten /nix/store/<hash>/... to /nix/#/... in process args.
---
 src/btop_tools.cpp         | 46 ++++++++++++++++++++++++++++++++++++++
 src/btop_tools.hpp         |  2 ++
 src/linux/btop_collect.cpp |  1 +
 3 files changed, 49 insertions(+)

diff --git a/src/btop_tools.cpp b/src/btop_tools.cpp
index 62b22e7..e760a1c 100644
--- a/src/btop_tools.cpp
+++ b/src/btop_tools.cpp
@@ -666,4 +666,50 @@ namespace Tools {
 	bool DebugTimer::is_running() {
 		return running;
 	}
+
+	auto strip_cmd_path(string_view cmd) -> string {
+		auto next_token = [](string_view s, size_t pos) -> std::pair<string_view, size_t> {
+			size_t end = s.find(' ', pos);
+			if (end == string_view::npos) end = s.size();
+			return { s.substr(pos, end - pos), end < s.size() ? end + 1 : s.size() };
+		};
+
+		auto strip_nix_store = [](string_view str) -> string {
+			constexpr string_view store = "/nix/store/";
+
+			if (!str.starts_with(store))
+				return string(str);
+
+			string_view after_store = str.substr(store.size());
+			size_t hash_end = after_store.find('-');
+
+			if (hash_end == string_view::npos)
+				return string(str);
+
+			string_view after_hash = after_store.substr(hash_end + 1);
+			size_t slash = after_hash.find('/');
+
+			if (slash == string_view::npos)
+				return "/nix/#-" + string(after_hash);
+			else
+				return "/nix/#/" + string(after_hash.substr(slash + 1));
+		};
+
+		string result;
+		result.reserve(cmd.size());
+
+		auto [cmd_name, pos] = next_token(cmd, 0);
+		size_t slash = cmd_name.rfind('/');
+		result += slash != string_view::npos
+			? cmd_name.substr(slash + 1)
+			: cmd_name;
+
+		while (pos < cmd.size()) {
+			auto [arg, next] = next_token(cmd, pos);
+			pos = next;
+			result += ' ' + strip_nix_store(arg);
+		}
+
+		return result;
+	}
 }
diff --git a/src/btop_tools.hpp b/src/btop_tools.hpp
index 92f452f..707fc57 100644
--- a/src/btop_tools.hpp
+++ b/src/btop_tools.hpp
@@ -386,6 +386,8 @@ namespace Tools {
 
 	//* Convert a celsius value to celsius, fahrenheit, kelvin or rankin and return tuple with new value and unit.
 	auto celsius_to(const long long& celsius, const string& scale) -> tuple<long long, string>;
+
+	auto strip_cmd_path(string_view cmd) -> string;
 }
 
 namespace Tools {
diff --git a/src/linux/btop_collect.cpp b/src/linux/btop_collect.cpp
index 1d52a44..35ed53d 100644
--- a/src/linux/btop_collect.cpp
+++ b/src/linux/btop_collect.cpp
@@ -3054,6 +3054,7 @@ namespace Proc {
 					}
 					pread.close();
 					if (not new_proc.cmd.empty()) new_proc.cmd.pop_back();
+					new_proc.cmd = Tools::strip_cmd_path(new_proc.cmd);
 
 					pread.open(d.path() / "status");
 					if (not pread.good()) continue;
